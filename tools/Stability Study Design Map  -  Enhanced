<script>
function setMode(mode) {
  const wrap = document.getElementById('map-wrap');
  const btnRef = document.getElementById('btn-reference');
  const btnAss = document.getElementById('btn-assessment');
  const hint = document.getElementById('mode-hint');
  if (mode === 'assessment') {
    wrap.classList.add('kc-mode');
    btnRef.classList.remove('active'); btnRef.classList.add('inactive');
    btnAss.classList.remove('inactive'); btnAss.classList.add('active');
    hint.style.display = 'block';
    document.querySelectorAll('.phase-body .node-action').forEach(node => {
      if (!node.querySelector('.kc-overlay')) {
        const overlay = document.createElement('div');
        overlay.className = 'kc-overlay';
        overlay.innerHTML = '<span>Click to reveal this step</span>';
        overlay.onclick = function(e) { e.stopPropagation(); node.classList.add('revealed'); };
        node.style.position = 'relative';
        node.appendChild(overlay);
      }
      node.classList.remove('revealed');
    });
  } else {
    wrap.classList.remove('kc-mode');
    btnAss.classList.remove('active'); btnAss.classList.add('inactive');
    btnRef.classList.remove('inactive'); btnRef.classList.add('active');
    hint.style.display = 'none';
    document.querySelectorAll('.node-action').forEach(n => n.classList.remove('revealed'));
  }
}
</script>
